#!/usr/bin/env bash
# =============================================================================
# config.env — Zentrale Konfiguration für IAC-MAAS
#
# Alle Scripts lesen diese Datei via: source config.env
# Vor dem ersten Einsatz ALLE Werte an die eigene Umgebung anpassen!
# =============================================================================

# ── Organisation ─────────────────────────────────────────────────────────
BAUER_ORG="bauer-group"
BAUER_DOMAIN="cloud.bauer-group.com"
BAUER_ADMIN_EMAIL="admin@bauer-group.com"
BAUER_GITHUB_USER="gh:karlbauer"
BAUER_TIMEZONE="Etc/UTC"

# ── MAAS ──────────────────────────────────────────────────────────────────
MAAS_CHANNEL="3.5/stable"
MAAS_ADMIN_USER="admin"

# ── Netzwerk ──────────────────────────────────────────────────────────────
# VLAN IDs ab 100 (niedrige IDs für Topologie-VLANs reserviert)
PROVISION_VLAN_ID=100
PROVISION_CIDR="10.100.0.0/16"
PROVISION_GW="10.100.0.1"
PROVISION_DHCP_START="10.100.1.1"
PROVISION_DHCP_END="10.100.255.250"

MGMT_VLAN_ID=110
MGMT_CIDR="10.110.0.0/16"
MGMT_GW="10.110.0.1"

BMC_VLAN_ID=120
BMC_CIDR="10.120.0.0/16"
BMC_GW="10.120.0.1"

# ── DNS / NTP ─────────────────────────────────────────────────────────────
DNS_SERVERS="8.8.8.8 1.1.1.1"
NTP_SERVERS="time.bauer-group.com"

# ── Ansible Integration ──────────────────────────────────────────────────
ANSIBLE_REPO_URL="https://github.com/bauer-group/IAC-Ansible.git"
ANSIBLE_REPO_BRANCH="main"
ANSIBLE_PULL_INTERVAL=30
